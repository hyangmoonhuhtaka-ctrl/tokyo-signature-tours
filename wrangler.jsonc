{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tst-google-reviews",
  "main": "worker/google-reviews.mjs",
  "compatibility_date": "2026-08-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "GOOGLE_REVIEWS_SYNC_ENABLED": "false"
  },
  "triggers": {
    "crons": ["17 0 * * *"]
  },
  "observability": {
    "enabled": false
  }
}
